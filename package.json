{
  "name": "ai-company",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "AI 一人公司 — 桌面客户端（Electron + React + src/core 编排核心）",
  "main": "./out/main/index.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:deps": "node scripts/check-deps.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:public-face": "node scripts/check-public-face.mjs",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "test": "node scripts/check-privacy.mjs && node scripts/check-public-face.mjs && node scripts/check-node.mjs && node scripts/check-deps.mjs && tsc -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && node scripts/audit/chain-gaps.mjs && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release:publish": "node scripts/release-publish.mjs",
  "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.11",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.7"
  },
  "author": "ai-company team",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/phonedu/ai-company.git"
  }
}
